# ── OpenAI ──────────────────────────────────
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2

# ── TTS Backend ──────────────────────────────
TTS_BACKEND=openai        # openai | elevenlabs | pyttsx3
OPENAI_TTS_VOICE=alloy    # alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_MODEL=tts-1    # tts-1 | tts-1-hd

# ── Whisper ───────────────────────────────────
WHISPER_BACKEND=api       # api | local
WHISPER_LANGUAGE=en
WHISPER_LOCAL_MODEL=base  # tiny | base | small | medium | large

# ── LLM ──────────────────────────────────────
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_SYSTEM_PROMPT=You are ARIA, a helpful voice assistant.
MAX_HISTORY_TURNS=20

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
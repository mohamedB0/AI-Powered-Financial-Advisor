# ─── Ollama (Local LLM) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=mistral

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=findb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/findb

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=financial_docs

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── App ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
# Persist directory (relative to project root or absolute)
CHROMA_PERSIST_DIR=chroma_db

# Active collection for NEW ingestion tasks (future data)
CHROMA_COLLECTION=financial_data

# Legacy collection (existing 288 scraped docs — read-only going forward)
# CHROMA_COLLECTION=financial_docs_cdc_hcp

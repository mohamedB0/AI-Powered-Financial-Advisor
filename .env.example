# ══════════════════════════════════════════════════════════════════
#  AI Financial Advisor — Environment Variables Template
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your real API keys below
#  3. NEVER commit .env to git
# ══════════════════════════════════════════════════════════════════

# ── LLM via OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
FAST_LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# ── HuggingFace (OCR via olmOCR) ──────────────────────────────────
# Free token: https://huggingface.co/settings/tokens
HUGGINGFACE_Token=hf_YOUR_KEY_HERE

# ── Web Search (Tavily) ───────────────────────────────────────────
TAVILY_API_KEY=tvly-YOUR_KEY_HERE

# ── Reranker (Jina AI) ────────────────────────────────────────────
JINA_API_KEY=jina_YOUR_KEY_HERE

# ── Embedding Model (HuggingFace) ─────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/app/chroma_db
CHROMA_COLLECTION=financial_data

# ── PostgreSQL ────────────────────────────────────────────────────
# In Docker:    POSTGRES_HOST=postgres  (service name)
# Locally:      POSTGRES_HOST=localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=financial_advisor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
DATABASE_URL=postgresql+psycopg2://postgres:root@postgres:5432/financial_advisor

# ── Redis / Celery ────────────────────────────────────────────────
# In Docker:    REDIS_HOST=redis  (service name)
# Locally:      REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Flask UI ──────────────────────────────────────────────────────
# In Docker:    API_BASE_URL=http://api:8000  (internal service name)
# Locally:      API_BASE_URL=http://localhost:8000
API_BASE_URL=http://api:8000

# ── Authentication (Google OAuth + JWT session) ──────────────────
# CRITICAL: Change JWT_SECRET to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_64_CHAR_STRING
JWT_EXPIRATION_HOURS=24

# Google OAuth — Create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web application)
# 2. Add your frontend URL to "Authorized JavaScript origins"
# 3. Paste the Client ID below
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5000,http://localhost:3000
